# Frontend and backend local development settings
REACT_APP_ORGANIZATION_NAME=Your Gurdwara
REACT_APP_ORGANIZATION_SHORT_NAME=Your Gurdwara
REACT_APP_SITE_DESCRIPTION=A digital platform for Gurdwara services, community programs, education, and donations.
REACT_APP_PUBLIC_SITE_URL=
REACT_APP_CONTACT_PHONE=
REACT_APP_CONTACT_EMAIL=
REACT_APP_CONTACT_ADDRESS=
REACT_APP_YOUTUBE_URL=
REACT_APP_FACEBOOK_URL=
REACT_APP_INSTAGRAM_URL=
REACT_APP_GOOGLE_OAUTH_URL=
REACT_APP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_EMAIL=
REACT_APP_APPROVAL_EMAIL_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
REACT_APP_NEWSLETTER_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
REACT_APP_DARBAR_SAHIB_STREAM_URL=/api/streaming/darbar-sahib/live
REACT_APP_SIKHNET_GURPURAB_CALENDAR_URL=https://sikhnet.com/pages/sikh-gurpurab-calendar
# Gurpurab API reference: https://api.gurpurab.com/
# Base URL used for yearly holidays (?year=...) and upcoming holidays (/upcoming?limit=...).
REACT_APP_GURPURAB_HOLIDAYS_API_URL=https://api.gurpurab.com/v1/holidays

# Volunteer reminder scheduler (daily send time in 24h format)
VOLUNTEER_REMINDER_SEND_TIME=09:00
VOLUNTEER_REMINDER_TIME_ZONE=America/Toronto
VOLUNTEER_REMINDER_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
EVENT_REMINDER_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay
DONATION_INVOICE_WEBHOOK_URL=http://127.0.0.1:4242/api/internal/mail-relay

# Local relay sender and optional explicit relay URL override.
LOCAL_MAIL_FROM=no-reply@example.invalid
INTERNAL_MAIL_RELAY_URL=http://127.0.0.1:4242/api/internal/mail-relay

# Mail transport mode:
# - sendmail (default): uses local /usr/sbin/sendmail
# - smtp: uses SMTP provider via nodemailer
LOCAL_MAIL_TRANSPORT=smtp

# Active SMTP provider: gmail, smtp2go, or custom.
# Keep gmail until SMTP2GO credentials and SPF/DKIM are ready.
SMTP_PROVIDER=gmail

# Gmail/current custom SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Future SMTP2GO settings. These remain isolated until SMTP_PROVIDER=smtp2go.
SMTP2GO_HOST=mail.smtp2go.com
SMTP2GO_PORT=587
SMTP2GO_SECURE=false
SMTP2GO_USER=
SMTP2GO_PASS=
SMTP2GO_FROM=

# Newsletter delivery uses one private BCC message per subscriber so every
# message has a unique signed unsubscribe URL.
PUBLIC_SITE_URL=
NEWSLETTER_UNSUBSCRIBE_SECRET=
NEWSLETTER_SEND_CONCURRENCY=3

HOST=0.0.0.0
PORT=3001
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# Zeffy donation API and webhook (server-only; never use REACT_APP_ for secrets)
ZEFFY_API_KEY=
# Optional only when the webhook sender is configured with the same custom token.
ZEFFY_WEBHOOK_TOKEN=
ZEFFY_CAMPAIGN_ID=
ZEFFY_CAMPAIGN_NAME=Help Us Build Our Gurdwara

# YouTube
YOUTUBE_API_KEY=

# Kids Word of the Week AI guide. Use Gemini in production with a free-tier
# Google AI Studio project that has billing disabled. Keep this key server-only.
GURMAT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GURMAT_AI_TIMEOUT_MS=60000
RATE_LIMIT_GURMAT_AI_MAX_REQUESTS=10
RATE_LIMIT_GURMAT_AI_WINDOW_MS=3600000

# Optional local fallback. No API key is required when Ollama is running.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# Runtime database. PostgreSQL remains the default; use mysql after a validated migration.
DB_ENGINE=postgresql

# PostgreSQL database
# Example (Neon/Supabase/Railway/Render managed Postgres):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Optional discrete DB fields (use only if DATABASE_URL is not provided)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# MySQL 8 database. MYSQL_URL takes precedence over the discrete MYSQL_* fields.
# Example: mysql://USER:PASSWORD@HOST:3306/DBNAME
MYSQL_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_POOL_SIZE=10

# OpenWA WhatsApp group notifications (server-only; never use REACT_APP_ for secrets).
# Keep notifications disabled until the linked WhatsApp session is a member of the target group.
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# OpenWA group chat ID, e.g. 120363...@g.us (not the chat.whatsapp.com invite URL).
# Configure a group chat ID for your deployment if notifications are enabled.
WA_GROUP_ID=
WA_NOTIFICATIONS_ENABLED=false
WA_DRY_RUN=true
# Quiet window for coalescing a burst of Langar grocery edits (milliseconds).
WA_BURST_WINDOW_MS=45000
SITE_BASE_URL=

# Social-card publishing (server-only; never use REACT_APP_ for credentials).
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
SOCIAL_WHATSAPP_RECIPIENT_TYPE=individual
SOCIAL_WHATSAPP_TO=
SOCIAL_WHATSAPP_GROUP_ID=
ENABLE_SOCIAL_CARDS=false
SOCIAL_CARDS_TIME_ZONE=America/Toronto
SOCIAL_ORGANIZATION_NAME=Your Gurdwara

# Meta webhook callback uses https://YOUR_DOMAIN/api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
